{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:theme(ether|prism|orbit|tide|transit|cascade|kinetic)",
      "destination": "/:theme/",
      "permanent": false
    }
  ]
}
